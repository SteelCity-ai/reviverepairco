# ── Revive Portal API — Environment Variables (NAMES ONLY, no values) ──────
# Copy to .env and populate for your environment.

# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string
DATABASE_URL=

# Clerk authentication secret
CLERK_SECRET_KEY=

# ── AI Integration ─────────────────────────────────────────────────────────
AI_INTEGRATIONS_OPENAI_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=

# ── Email (Zoho SMTP) ──────────────────────────────────────────────────────
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=

# ── Internal API ────────────────────────────────────────────────────────────
# Bearer secret for internal routes (daily-summary, clerk webhook sync)
INTERNAL_CRON_SECRET=

# ── Media Storage (RAP-2.0b) ────────────────────────────────────────────────
# Backend: "local" (default) or "replit-object"
MEDIA_BACKEND=local
# Local filesystem root for media (default /data/media)
MEDIA_ROOT=/data/media
# Public base URL for media assets (e.g. https://reviverepairco.com/media)
MEDIA_BASE_URL=/media

# ── Replit Object Storage (used when MEDIA_BACKEND=replit-object) ────────────
# DEPRECATED_ prefixed to discourage new usage; kept for fallback adapter.
# REPLIT_OBJECT_STORAGE_BUCKET_ID=
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=

# ── Server ─────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=development
PORTAL_PUBLIC_URL=http://localhost:3001
