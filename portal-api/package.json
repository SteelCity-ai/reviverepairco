{
  "name": "@revive/api-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx lib/db/migrate.ts",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@clerk/express": "^1",
    "compression": "^1",
    "cors": "^2",
    "dotenv": "^16",
    "drizzle-orm": "^0.39",
    "express": "^5",
    "helmet": "^8",
    "multer": "^1",
    "nodemailer": "^6",
    "postgres": "^3",
    "uuid": "^10",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/compression": "^1",
    "@types/cors": "^2",
    "@types/express": "^5",
    "@types/multer": "^1",
    "@types/node": "^20",
    "@types/nodemailer": "^6",
    "@types/uuid": "^10",
    "drizzle-kit": "^0.30",
    "tsx": "^4",
    "typescript": "^5"
  }
}
